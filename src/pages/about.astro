---
import Marques from '../components/home/Marques.astro';
import Container from '../components/ui/Container.astro';
import HowBuyingWorks from '../components/ui/HowBuyingWorks.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { locations } from '../data/locations';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Boston Motors is a growing automotive company dealing in premium pre-owned vehicles, with a presence in Calicut and Delhi."
>
  <PageHeader
    eyebrow="About"
    title="More than a dealership."
    intro="A growing automotive company built around premium pre-owned vehicles and the people who buy them."
  />

  <HowBuyingWorks />

  {/* Presence lives here until there is enough location detail to justify its own page. */}
  <section class="border-t border-line bg-band py-section" aria-labelledby="presence">
    <Container>
      <p class="eyebrow mb-4">Our presence</p>
      <h2 id="presence" class="text-3xl sm:text-4xl">Building beyond boundaries.</h2>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          locations.map((location) => (
            <li class="rounded-md border border-line bg-panel p-8" data-reveal>
              <h3 class="font-display text-2xl">{location.city}</h3>
              {/* Never a fabricated address — and never a "coming soon" line
                  either, which just advertises that the site is unfinished. */}
              {location.address && <p class="mt-3 card-copy">{location.address}</p>}
              {location.mapUrl && (
                <a
                  href={location.mapUrl}
                  class="link-underline mt-5 inline-flex w-fit items-center gap-2 font-display text-sm font-semibold text-teal-light"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View location
                  <span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-14" data-reveal>
        <p class="eyebrow mb-5">Follow Boston Motors</p>
        <SocialLinks size="md" />
      </div>
    </Container>
  </section>

  <Marques />
</BaseLayout>
