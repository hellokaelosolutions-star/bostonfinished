---
import { Image } from 'astro:assets';

import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Business"
  description="What Boston Motors does: pre-owned vehicle sales, other-state registration support, and authorized service."
>
  <PageHeader
    eyebrow="Our business"
    title="More than a vehicle. A complete ownership experience."
    intro="Three lines of business, built so that ownership is supported before, during and long after the sale."
  />

  <section class="py-section lg:py-section-lg">
    <Container>
      <ul class="flex flex-col gap-16 lg:gap-24">
        {
          services.map((service, index) => (
            <li
              id={service.id}
              class:list={[
                'scroll-mt-28 grid items-center gap-8 lg:grid-cols-2 lg:gap-16',
                // Alternate the image side on desktop; mobile always stacks image-first.
                index % 2 === 1 && 'lg:[&>figure]:order-2',
              ]}
              data-reveal
            >
              <figure class="overflow-hidden rounded-md border border-line">
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[480, 800]}
                  sizes="(min-width: 1024px) 45vw, 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="aspect-4/3 w-full object-cover lg:aspect-3/4"
                />
              </figure>

              <div>
                <span class="font-display text-xs font-semibold tracking-[0.18em] text-teal-light">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2 class="mt-3 text-3xl sm:text-4xl">{service.title}</h2>

                {/* DRAFT COPY — one line only, until Boston Motors supplies the real
                    description of each service. Deliberately claims nothing about
                    coverage, warranty, pricing or manufacturer authorisation. */}
                <p class="measure mt-5 text-muted">{service.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

</BaseLayout>
