---
import { Image } from 'astro:assets';

import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessId } from '../lib/seo';

const origin = Astro.site ?? Astro.url;
const serviceSchema = services.map((service) => ({
  '@type': 'Service',
  '@id': new URL(`/business/#${service.id}`, origin).href,
  name: service.title,
  description: service.summary,
  url: new URL(`/business/#${service.id}`, origin).href,
  provider: { '@id': businessId(origin) },
}));
---

<BaseLayout
  title="Pre-Owned Sales, Other-State Cars & Service | Boston Motors"
  description="Boston Motors in Calicut offers curated pre-owned luxury cars, support with vehicles registered outside Kerala, and ongoing service after the sale."
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Business', path: '/business/' },
  ]}
  schema={serviceSchema}
>
  <PageHeader
    eyebrow="Our services"
    title="More than a vehicle. A complete ownership experience."
    intro="Three lines of business, built so that ownership is supported before, during and long after the sale."
  />

  <section class="py-section lg:py-section-lg">
    <Container>
      <ul class="flex flex-col gap-14 md:gap-16 lg:gap-24">
        {
          services.map((service, index) => (
            <li
              id={service.id}
              class:list={[
                'scroll-mt-24 grid items-center gap-6 md:grid-cols-2 md:gap-10 lg:gap-16',
                // Alternate the image side from tablet up; phones always stack image-first.
                index % 2 === 1 && 'md:[&>figure]:order-2',
              ]}
            >
              <figure class="overflow-hidden rounded-md bg-panel">
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[480, 800]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="aspect-4/3 w-full object-cover lg:aspect-3/4"
                />
              </figure>

              <div>
                <h2 class="t-section">{service.title}</h2>

                {/* DRAFT COPY — one line only, until Boston Motors supplies the real
                    description of each service. Deliberately claims nothing about
                    coverage, warranty, pricing or manufacturer authorisation. */}
                <p class="measure mt-3 text-muted sm:mt-5">{service.summary}</p>

                <a
                  href={service.next.href}
                  class="tap mt-3 gap-2 font-display text-sm font-semibold text-teal-light"
                >
                  {service.next.label} <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

</BaseLayout>
