---
import CarCard from '../../components/cars/CarCard.astro';
import SellVehicleCTA from '../../components/home/SellVehicleCTA.astro';
import Container from '../../components/ui/Container.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getCars } from '../../lib/cars';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cars = await getCars();

// Built from live inventory so the description never names a car that has sold.
const brands = [...new Set(cars.map((car) => car.brand))].slice(0, 4);
const brandList =
  brands.length > 1 ? `${brands.slice(0, -1).join(', ')} and ${brands.at(-1)}` : brands[0];
const description = brandList
  ? `Pre-owned luxury cars for sale in Calicut, including ${brandList}. Enquire with Boston Motors to confirm availability and price.`
  : 'Pre-owned luxury cars for sale in Calicut. Enquire with Boston Motors to confirm availability and price.';
---

<BaseLayout
  title="Used Luxury Cars for Sale in Calicut | Boston Motors"
  description={description}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Cars', path: '/cars/' },
  ]}
>
  <PageHeader
    eyebrow="Pre-owned cars for sale"
    title="Currently on the floor."
    intro="Availability changes often. Enquire about any vehicle and we will confirm its current status."
  />

  <section class="py-section lg:py-section-lg">
    <Container>
      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          cars.map((car, index) => (
            <CarCard car={car} loading={index < 3 ? 'eager' : 'lazy'} heading="h2" />
          ))
        }
      </div>
    </Container>
  </section>

  <SellVehicleCTA />
</BaseLayout>
