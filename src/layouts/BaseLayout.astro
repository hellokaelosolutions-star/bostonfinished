---
import { Font } from 'astro:assets';

import Footer from '../components/global/Footer.astro';
import MobileCTA from '../components/global/MobileCTA.astro';
import Navbar from '../components/global/Navbar.astro';
import { site } from '../data/site';
import { pageGraph, type Crumb } from '../lib/seo';
import '../styles/global.css';

interface Props {
  /** The complete <title>, written per page — not assembled from a template. */
  title: string;
  description: string;
  /** Absolute or root-relative share image. Defaults to the showroom storefront. */
  image?: string;
  imageAlt?: string;
  /** Breadcrumb trail for structured data, home first. Omitted on the homepage. */
  crumbs?: Crumb[];
  /** Page-specific JSON-LD nodes (a Car, the Services…) added to the graph. */
  schema?: Record<string, unknown>[];
  /** For pages that must never be indexed (the 404). Drops canonical and JSON-LD too. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'The Boston Motors showroom on Mini Bypass, Calicut',
  crumbs,
  schema,
  noindex = false,
} = Astro.props;

// `site` is set in astro.config.mjs; every URL a crawler or social card sees
// is absolute and on the one canonical origin. Query strings never reach it.
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
const graph = pageGraph({ origin, canonical, title, description, image: imageUrl, crumbs, extra: schema });
---

<!doctype html>
<html lang="en-IN" class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      image === '/og-image.jpg' && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script is:inline type="application/ld+json" set:html={graph} />}

    <meta name="theme-color" content="#071014" />
    {/* ?v=2 busts browsers still holding the old Astro icon from the first deploy. */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png?v=2" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-inter" preload />

    {/* Set before paint so reveal elements never flash in at full opacity. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Netlify Identity sends invite/recovery links to the site root with a
        token in the hash. Hand them to the CMS admin page, which loads the
        widget and picks the token up from there. */}
    <script is:inline>
      if (
        window.location.hash &&
        window.location.hash.match(
          /access_token|confirmation_token|invite_token|recovery_token|email_change_token/,
        )
      ) {
        window.location.href = '/admin/' + window.location.hash;
      }
    </script>
  </head>

  <body class="bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:bg-teal focus:px-4 focus:py-2 focus:text-fg"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <MobileCTA />

    <script>
      // Featured-image settle. Stays visible if IntersectionObserver is
      // unavailable, because `html.js` is the only thing that hides it.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal-media]');

      if (!('IntersectionObserver' in window)) {
        document.documentElement.classList.remove('js');
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        for (const el of revealables) observer.observe(el);
      }
    </script>
  </body>
</html>
