---
import { Font } from 'astro:assets';

import Footer from '../components/global/Footer.astro';
import MobileCTA from '../components/global/MobileCTA.astro';
import Navbar from '../components/global/Navbar.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="en" class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.pathname} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* TODO: absolute canonical + og:image URLs need `site` set in astro.config.mjs. */}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-inter" preload />

    {/* Set before paint so reveal elements never flash in at full opacity. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Netlify Identity sends invite/recovery links to the site root with a
        token in the hash. Hand them to the CMS admin page, which loads the
        widget and picks the token up from there. */}
    <script is:inline>
      if (
        window.location.hash &&
        window.location.hash.match(
          /access_token|confirmation_token|invite_token|recovery_token|email_change_token/,
        )
      ) {
        window.location.href = '/admin/' + window.location.hash;
      }
    </script>
  </head>

  <body class="bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:bg-teal focus:px-4 focus:py-2 focus:text-fg"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <MobileCTA />

    <script>
      // Featured-image settle. Stays visible if IntersectionObserver is
      // unavailable, because `html.js` is the only thing that hides it.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal-media]');

      if (!('IntersectionObserver' in window)) {
        document.documentElement.classList.remove('js');
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        for (const el of revealables) observer.observe(el);
      }
    </script>
  </body>
</html>
