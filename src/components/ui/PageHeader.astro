---
import Container from './Container.astro';

interface Props {
  /** Says what the page is. Part of the <h1>, so it should be descriptive. */
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

{/* pt clears the fixed header. The eyebrow sits inside the <h1>: the display
    line alone ("How can we help?") says nothing about the page, the eyebrow
    ("Contact Boston Motors") does, and together they read as one heading. */}
<section class="border-b border-line bg-band pt-28 pb-12 sm:pt-32 sm:pb-16 lg:pt-44 lg:pb-24">
  <Container>
    <h1>
      {
        eyebrow && (
          <>
            <span class="eyebrow mb-3 block sm:mb-4">{eyebrow}</span>
            <span class="sr-only">: </span>
          </>
        )
      }
      <span class="t-page block max-w-3xl">{title}</span>
    </h1>
    {intro && <p class="mt-4 max-w-xl text-muted sm:mt-6">{intro}</p>}
  </Container>
</section>
