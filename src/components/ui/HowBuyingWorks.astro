---
import { Image } from 'astro:assets';

import aboutBg from '../../assets/images/about/about-bg.jpg';
import { buyingSteps } from '../../data/buying-steps';
import Container from './Container.astro';

interface Props {
  /** Only set on the homepage, where this is its own section with no page-level heading above it. */
  eyebrow?: string;
}

const { eyebrow } = Astro.props;
---

<section class="py-section lg:py-section-lg">
  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="relative overflow-hidden rounded-lg bg-panel">
        <Image
          src={aboutBg}
          alt="The Boston Motors showroom storefront"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="lazy"
          class="aspect-4/3 w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/25"></div>
      </div>

      <div>
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h2 class="t-section">How buying works</h2>
        <p class="mt-5 max-w-md text-muted">From first look to handing over the keys, in four steps.</p>

        {/* A real sequence, so these are the numbers on the site that earn it. */}
        <ol class="mt-10 border-t border-line">
          {
            buyingSteps.map((step, index) => (
              <li class="grid grid-cols-[2.5rem_1fr] border-b border-line py-5">
                <span class="pt-0.5 font-display text-sm font-semibold text-teal-light tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold">{step.title}</h3>
                  <p class="mt-1 card-copy">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Container>
</section>
