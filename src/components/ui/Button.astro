---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  /** Full width on mobile, auto from `sm` up — the default for hero/CTA pairs. */
  block?: boolean;
  class?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  block = false,
  class: className = '',
  type = 'button',
} = Astro.props;

// min-h-11 keeps every button at/above the 44px touch target.
const base =
  'group inline-flex min-h-11 items-center justify-center gap-2 rounded-sm px-5 py-2.5 font-display text-sm font-semibold transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-soft)]';

const variants = {
  // A step in fill strength rather than a second colour, so the hover reads in
  // both scopes — deep teal on the page, the inverted ivory fill in `.on-teal`.
  primary: 'bg-teal text-inverse hover:bg-teal/85',
  // Deliberately quiet: muted text on a hairline, so a primary/secondary pair
  // reads as one clear action and one alternative, not two equal buttons.
  secondary: 'border border-line text-muted hover:border-teal-light/50 hover:text-fg',
  ghost: 'text-muted hover:text-fg px-0',
};

const classes = [base, variants[variant], block && 'w-full sm:w-auto', className];

const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type}>
  <slot />
</Tag>
