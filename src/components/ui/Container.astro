---
interface Props {
  as?: string;
  class?: string;
  /** Narrower measure for reading-heavy blocks. */
  size?: 'default' | 'narrow';
}

const { as: Tag = 'div', class: className = '', size = 'default' }: Props = Astro.props;

const width = size === 'narrow' ? 'max-w-3xl' : 'max-w-[1240px]';
---

<Tag class:list={[width, 'mx-auto w-full px-5 sm:px-8', className]}>
  <slot />
</Tag>
