---
import type { Car } from '../../lib/cars';

interface Props {
  car: Car;
  /** Only the first card or two on a page should load eagerly. */
  loading?: 'eager' | 'lazy';
  sizes?: string;
  /**
   * `feature` is the editorial treatment: full-bleed wide photography with the
   * name overlaid. Use it for one vehicle at a time — its weight is the whole
   * point, and it disappears if everything is a feature.
   */
  variant?: 'default' | 'feature';
}

const {
  car,
  loading = 'lazy',
  sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw',
  variant = 'default',
} = Astro.props;

// Specs are optional by design — the card must look intentional without them.
const specs = [car.year, car.fuel, car.transmission].filter(Boolean);
const meta = specs.length > 0 ? specs.join(' · ') : car.category;

const imageHover =
  'transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-soft)]';
---

{
  variant === 'feature' ? (
    <article class="group relative">
      <a href={`/cars/${car.slug}`} class="block">
        {/* The page's one scroll moment: the photograph settles into place. */}
        <div class="relative overflow-hidden rounded-md bg-panel">
          <div data-reveal-media>
            <img
              src={car.image}
              alt={car.alt}
              sizes={sizes}
              loading={loading}
              class:list={[
                'aspect-3/2 w-full object-cover group-hover:scale-[1.02] sm:aspect-16/9 lg:aspect-21/9',
                imageHover,
              ]}
            />
          </div>

          {/* Legibility scrim for the overlaid type — only where the type is
              actually overlaid. */}
          <div class="absolute inset-x-0 bottom-0 hidden h-2/3 bg-gradient-to-t from-bg/90 to-transparent sm:block" />
        </div>

        {/* On a phone the photograph is too small to carry type without hiding
            the car, so the text sits beneath it; from sm it moves onto it. */}
        <div class="pt-5 sm:absolute sm:inset-x-0 sm:bottom-0 sm:p-10">
          <p class="font-display text-xs font-semibold tracking-[0.18em] text-muted uppercase">
            {car.brand}
          </p>
          <h3 class="mt-1 font-display text-2xl font-semibold sm:text-4xl">{car.model}</h3>
          <p class="mt-3 card-copy">{meta}</p>
          {car.price && (
            <p class="mt-1 font-display text-[0.9375rem] font-semibold text-fg">{car.price}</p>
          )}

          <span class="tap mt-2 gap-2 font-display text-sm font-semibold text-teal-light sm:mt-3">
            Explore vehicle
            <span
              class="transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </span>
        </div>
      </a>
    </article>
  ) : (
    <article class="group">
      <a href={`/cars/${car.slug}`} class="block">
        <div class="overflow-hidden rounded-md bg-panel">
          <img
            src={car.image}
            alt={car.alt}
            sizes={sizes}
            loading={loading}
            class:list={['aspect-3/2 w-full object-cover group-hover:scale-[1.03]', imageHover]}
          />
        </div>

        <div class="mt-4 flex items-start justify-between gap-4">
          <div>
            <p class="font-display text-xs font-semibold tracking-[0.16em] text-muted uppercase">
              {car.brand}
            </p>
            <h3 class="mt-1 font-display text-xl font-semibold transition-colors group-hover:text-teal-light">
              {car.model}
            </h3>
            <p class="mt-1 card-copy">{meta}</p>
          </div>

          {car.price && (
            <p class="shrink-0 pt-4 font-display text-[0.9375rem] font-semibold text-fg">
              {car.price}
            </p>
          )}
        </div>
      </a>
    </article>
  )
}
