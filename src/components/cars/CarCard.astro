---
import type { Car } from '../../lib/cars';

interface Props {
  car: Car;
  /** Only the first card or two on a page should load eagerly. */
  loading?: 'eager' | 'lazy';
  sizes?: string;
  /**
   * `feature` is the editorial treatment: full-bleed wide photography with the
   * name overlaid. Use it for one vehicle at a time — its weight is the whole
   * point, and it disappears if everything is a feature.
   */
  variant?: 'default' | 'feature';
  /** Milliseconds to offset this card's scroll reveal, for staggering a row. */
  revealDelay?: number;
}

const {
  car,
  loading = 'lazy',
  sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw',
  variant = 'default',
  revealDelay = 0,
} = Astro.props;

const revealStyle = revealDelay ? `--reveal-delay: ${revealDelay}ms` : undefined;

// Specs are optional by design — the card must look intentional without them.
const specs = [car.year, car.fuel, car.transmission].filter(Boolean);
---

{
  variant === 'feature' ? (
    <article
      class="group relative overflow-hidden rounded-md border border-line bg-panel transition-colors duration-[var(--duration-normal)] hover:border-teal-light/40"
      data-reveal
      style={revealStyle}
    >
      <a href={`/cars/${car.slug}`} class="block">
        {/* The page's one deliberate scroll moment: the photograph settles, then
            the type arrives over it. */}
        <div data-reveal-media>
          <img
            src={car.image}
            alt={car.alt}
            sizes={sizes}
            loading={loading}
            class="aspect-4/3 w-full object-cover transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-soft)] group-hover:scale-[1.035] sm:aspect-16/9 lg:aspect-21/9"
          />
        </div>

        <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/40 to-transparent" />

        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
          {/* Brand sits above the model, smaller and spaced — the marque is the
              label, the model is the headline. One visual weight for both reads
              as a listing. */}
          <p
            class="font-display text-xs font-semibold tracking-[0.2em] text-muted uppercase sm:text-sm"
            data-reveal
            style="--reveal-delay: 260ms"
          >
            {car.brand}
          </p>

          <h3
            class="mt-1 font-display text-3xl font-semibold sm:text-4xl lg:text-5xl"
            data-reveal
            style="--reveal-delay: 340ms"
          >
            {car.model}
          </h3>

          {/* Spacing expresses grouping: brand+model are one unit (4px), the
              meta block is a second unit (4px internally) held 16px away, and
              the action sits 28px clear of both. */}
          <div data-reveal style="--reveal-delay: 420ms">
            <p class="mt-4 card-copy">{specs.length > 0 ? specs.join(' · ') : car.category}</p>

            {/* Price shares the meta size — it is separated by weight and colour
                rather than by adding a fifth type size to one card. */}
            {car.price && (
              <p class="mt-1 font-display text-[0.9375rem] font-semibold text-fg">{car.price}</p>
            )}

            <span class="mt-7 inline-flex items-center gap-2 font-display text-sm font-semibold text-teal-light">
              Explore vehicle
              <span
                class="transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </span>
          </div>
        </div>
      </a>
    </article>
  ) : (
    <article
      class="group overflow-hidden rounded-md border border-line bg-panel shadow-card transition-colors duration-[var(--duration-normal)] hover:border-teal-light/40"
      data-reveal
      style={revealStyle}
    >
      <a href={`/cars/${car.slug}`} class="block">
        <div class="overflow-hidden">
          <img
            src={car.image}
            alt={car.alt}
            sizes={sizes}
            loading={loading}
            class="aspect-16/10 w-full object-cover transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-soft)] group-hover:scale-[1.03]"
          />
        </div>

        <div class="p-6">
          <p class="font-display text-[0.6875rem] font-semibold tracking-[0.2em] text-muted uppercase">
            {car.brand}
          </p>

          <h3 class="mt-1 font-display text-xl font-semibold">{car.model}</h3>

          <p class="mt-3 card-copy">{specs.length > 0 ? specs.join(' · ') : car.category}</p>

          {car.price && (
            <p class="mt-1 font-display text-[0.9375rem] font-semibold text-fg">{car.price}</p>
          )}

          <span class="mt-6 inline-flex items-center gap-2 font-display text-sm font-semibold text-teal-light">
            Explore vehicle
            <span
              class="transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </span>
        </div>
      </a>
    </article>
  )
}
