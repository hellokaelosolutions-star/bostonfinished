---
import { Image } from 'astro:assets';

import logo from '../../assets/images/logo-boston-motors.png';
import { contact, navLinks, site } from '../../data/site';
import Container from '../ui/Container.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

{/* `data-scrolled` drives the header's treatment from CSS (see global.css).
    Rendered server-side so the correct state is in the HTML before first
    paint rather than being applied by a deferred script. */}
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-[var(--duration-normal)] ease-[var(--ease-out-soft)]"
  data-scrolled="false"
>
  <Container class="flex items-center justify-between py-5">
    <a href="/" class="relative z-10 shrink-0" aria-label={`${site.name} — home`}>
      <Image
        src={logo}
        alt={site.name}
        width={180}
        densities={[1, 2]}
        loading="eager"
        class="h-8 w-auto sm:h-9"
      />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-9">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'link-underline font-display text-sm font-medium tracking-wide transition-colors duration-[var(--duration-fast)]',
                  isActive(link.href) ? 'text-teal-light' : 'text-muted hover:text-fg',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="relative z-10 -mr-2 flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span class="relative block h-4 w-6" aria-hidden="true">
        <span
          class="absolute left-0 block h-px w-6 bg-fg transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-soft)]"
          data-bar="top"></span>
        <span
          class="absolute bottom-0 left-0 block h-px w-6 bg-fg transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-soft)]"
          data-bar="bottom"></span>
      </span>
    </button>
  </Container>

  {/*
    Mobile panel. Not a shrunken desktop nav: numbered index, large targets,
    and the secondary journeys (sell / social) pushed below a rule.
    Revealed with clip-path so the panel wipes down rather than fading.
  */}
  <div
    id="mobile-nav"
    class="invisible fixed inset-0 z-0 bg-bg lg:hidden"
    style="clip-path: inset(0 0 100% 0); transition: clip-path 520ms var(--ease-out-soft), visibility 520ms;"
  >
    <nav class="flex h-full flex-col justify-center px-7" aria-label="Mobile">
      <ul class="flex flex-col">
        {
          navLinks.map((link, index) => (
            <li data-nav-item style={`--nav-delay: ${120 + index * 55}ms`}>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="flex items-baseline gap-5 py-3.5"
              >
                <span class="font-display text-[0.6875rem] font-semibold tracking-[0.2em] text-teal-light">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span
                  class:list={[
                    'font-display text-[2rem] font-semibold tracking-tight',
                    isActive(link.href) ? 'text-teal-light' : 'text-fg',
                  ]}
                >
                  {link.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-8 border-t border-line pt-8"
        data-nav-item
        style={`--nav-delay: ${120 + navLinks.length * 55}ms`}
      >
        <a
          href="/sell-your-car"
          class="inline-flex items-center gap-2 font-display text-lg font-semibold text-fg"
        >
          Sell your vehicle
          <span aria-hidden="true">&rarr;</span>
        </a>

        <ul class="mt-6 flex flex-col gap-3">
          {
            contact.phone && (
              <li>
                <a href={contact.phoneHref} class="card-copy">
                  {contact.phone}
                </a>
              </li>
            )
          }
          {
            contact.instagram && (
              <li>
                <a href={contact.instagram} class="card-copy">
                  Instagram
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Links stagger in behind the panel wipe. */
  [data-nav-item] {
    opacity: 0;
    transform: translateY(14px);
  }

  #mobile-nav.is-open [data-nav-item] {
    opacity: 1;
    transform: none;
    transition:
      opacity 420ms var(--ease-out-soft) var(--nav-delay, 0ms),
      transform 420ms var(--ease-out-soft) var(--nav-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav {
      transition: none !important;
    }

    [data-nav-item] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  // Inline and parse-time, like the footer accordions, so the header never
  // paints its unscrolled state for a frame on a refresh that restores scroll
  // position.
  //
  // This used to carry a measured flip point — the bottom of the dark-to-light
  // transition band — because a light header could not appear over a dark hero.
  // With the page dark throughout, the only thing scroll changes is whether the
  // header needs a backdrop to separate it from the content passing underneath.
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;

    function applyScrollState() {
      var scrolled = window.scrollY > 24;
      header.dataset.scrolled = String(scrolled);
      header.classList.toggle('bg-bg/90', scrolled);
      header.classList.toggle('backdrop-blur-md', scrolled);
      header.classList.toggle('border-b', scrolled);
      header.classList.toggle('border-line', scrolled);
    }

    applyScrollState();
    window.addEventListener('scroll', applyScrollState, { passive: true });
  })();
</script>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;
  const bars = toggle.querySelectorAll<HTMLElement>('[data-bar]');

  // --- Mobile panel ---
  let open = false;

  const setOpen = (next: boolean) => {
    open = next;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');


    panel.classList.toggle('is-open', open);
    panel.classList.toggle('invisible', !open);
    panel.style.clipPath = open ? 'inset(0 0 0 0)' : 'inset(0 0 100% 0)';

    // Bars cross into an X.
    bars[0]?.style.setProperty('transform', open ? 'translateY(7px) rotate(45deg)' : '');
    bars[1]?.style.setProperty('transform', open ? 'translateY(-8px) rotate(-45deg)' : '');

    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(!open));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && open) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Close if the viewport grows into the desktop nav while the panel is open.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && open) setOpen(false);
  });
</script>
