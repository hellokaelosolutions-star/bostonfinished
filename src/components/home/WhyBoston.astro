---
import { pillars } from '../../data/why';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Full-width ruled rows, not a four-card grid — four equal boxes read as
 * feature bullets on a pricing page. These are qualities rather than steps, so
 * they carry no index numbers, and nothing moves on hover because nothing here
 * is clickable.
 */
---

<section class="py-section lg:py-section-lg">
  <Container>
    <SectionHeading eyebrow="Why Boston Motors" title="The Boston Motors experience." />

    <ul class="mt-12">
      {
        pillars.map((pillar) => (
          <li class="grid gap-2 border-t border-line py-6 last:border-b sm:grid-cols-[14rem_1fr] sm:items-baseline sm:gap-12 lg:grid-cols-[20rem_1fr] lg:py-8">
            <h3 class="t-card font-display font-semibold">{pillar.title}</h3>
            <p class="max-w-md card-copy">{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
