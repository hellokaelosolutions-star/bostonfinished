---
import { team } from '../../data/team';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import TeamPortrait from '../ui/TeamPortrait.astro';

/**
 * The homepage preview stays deliberately thinner than /team: portraits, names
 * and a way through. Roles and biographies belong on the page that exists to
 * answer "who runs this business", not in a passing glance on the homepage.
 */
---

{/* Back to the page ivory, and it stays ivory through PresencePreview below:
    "here are the people, here is where to find them" is one chapter. The
    boundary that carries meaning is the one above — leaving the Customer
    Stories band — not one between these two. */}
<section class="py-section lg:py-section-lg">
  <Container>
    <SectionHeading eyebrow="Our team" title="The people behind Boston Motors." />

    {/* 2 columns on phones, 4 from tablet up. Source assets vary in ratio, so
         the fixed 3:4 frame is what keeps the row even. */}
    <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 lg:gap-6">
      {
        team.map((member) => (
          <li>
            <TeamPortrait
              member={member}
              widths={[300, 500, 700]}
              sizes="(min-width: 768px) 23vw, 46vw"
            />

            <h3 class="mt-4 font-display text-lg font-semibold">{member.name}</h3>
            {member.role && <p class="card-copy">{member.role}</p>}
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <Button href="/team/" variant="secondary">Meet the team</Button>
    </div>
  </Container>
</section>
