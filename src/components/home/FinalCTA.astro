---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

/**
 * Three intents, three destinations. Kept as boxes — this is genuinely
 * grouped information — but stripped back to hairline dividers rather than
 * bordered panels, so the section reads as clean rather than as another
 * three-card row.
 *
 * The heading deliberately does NOT say "Let's start a conversation" — the
 * footer now owns that line on every page, and this sits directly above it.
 * This section routes by intent; the footer converts. Two different jobs.
 */
const paths = [
  { prompt: 'Looking for a vehicle?', label: 'Explore cars', href: '/cars' },
  { prompt: 'Selling a luxury vehicle?', label: 'Sell your vehicle', href: '/sell-your-car' },
  { prompt: 'Business or partnership?', label: 'Enquire', href: '/contact' },
];
---

<section class="border-t border-line py-section lg:py-section-lg">
  <Container>
    <div class="text-center" data-reveal>
      <h2 class="t-section mx-auto max-w-2xl">Where would you like to begin?</h2>
    </div>

    {/* Divider-separated columns, no card fills. */}
    <ul
      class="mx-auto mt-16 grid max-w-4xl gap-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-line"
    >
      {
        paths.map((path, index) => (
          <li
            class="flex flex-col items-center gap-5 text-center sm:px-7"
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <p class="card-copy">{path.prompt}</p>
            <Button href={path.href} variant={index === 0 ? 'primary' : 'secondary'} class="w-full">
              {path.label}
            </Button>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
