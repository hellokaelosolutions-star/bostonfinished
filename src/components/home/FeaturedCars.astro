---
import { getFeaturedCars } from '../../lib/cars';
import CarCard from '../cars/CarCard.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Editorial layout: one vehicle given real scale, two supporting it. A flat
 * four-up grid of small cards reads as an inventory marketplace — the whole
 * point of this section is that these cars look selected, not listed.
 */
const [lead, ...supporting] = await getFeaturedCars();
---

{/* Page ground. On ivory this section lifted to white to mark the shift into
    the product — on near-black the same move would be a grey slab competing
    with the vehicle photography it is supposed to present. The cars are the
    brightest thing here; the ground stays out of their way. */}
<section class="py-section lg:py-section-lg">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow="Featured collection" title="Currently on the floor." />

      <div class="hidden sm:block" data-reveal>
        <Button href="/cars" variant="secondary">View all vehicles</Button>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-6">
      <CarCard
        car={lead}
        variant="feature"
        loading="eager"
        sizes="(min-width: 1240px) 1176px, 100vw"
      />

      {/* Supporting cars land after the feature's type has settled, so the
           sequence reads photograph → title → the rest of the collection. */}
      <div class="grid gap-6 sm:grid-cols-2">
        {
          supporting.map((car, index) => (
            <CarCard
              car={car}
              sizes="(min-width: 640px) 46vw, 100vw"
              revealDelay={120 + index * 90}
            />
          ))
        }
      </div>
    </div>

    <div class="mt-10 sm:hidden">
      <Button href="/cars" variant="secondary" block>View all vehicles</Button>
    </div>
  </Container>
</section>
