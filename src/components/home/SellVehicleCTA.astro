---
import { Image } from 'astro:assets';

import backdrop from '../../assets/images/cars/car-porsche-911.webp';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

/**
 * Full-width band, not a card: for one screen it turns the visitor from buyer
 * to seller. A clean colour block with hard edges — the change of ground is the
 * divider, so nothing fades into it.
 *
 * DRAFT COPY — approve with Boston Motors before launch.
 */
---

<section class="on-teal relative overflow-hidden bg-bg">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={backdrop}
      alt=""
      layout="full-width"
      loading="lazy"
      class="h-full w-full object-cover object-center"
    />
    {/* Heavy scrim: the photograph is texture here, not the subject. */}
    <div class="absolute inset-0 bg-bg/90"></div>
  </div>

  <Container class="relative py-section lg:py-24">
    <div class="grid items-end gap-7 md:grid-cols-[1fr_auto] md:gap-12">
      <div class="max-w-2xl">
        <p class="eyebrow">Have something special?</p>
        <h2 class="t-section mt-4">Considering selling your luxury vehicle?</h2>
        <p class="mt-5 max-w-md text-muted">
          Tell us a little about it, and we will come back to you directly and discreetly.
        </p>
      </div>

      <div>
        <Button href="/sell-your-car" variant="primary" block>Sell your vehicle</Button>
      </div>
    </div>
  </Container>
</section>
