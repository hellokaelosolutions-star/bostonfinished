---
import { locations } from '../../data/locations';
import { contact } from '../../data/site';
import Container from '../ui/Container.astro';
import ViewOnMap from '../ui/ViewOnMap.astro';

// Incomplete locations never appear here: this section only represents a
// confirmed showroom a visitor can actually reach.
const verifiedLocations = locations.filter((location) => location.address && location.mapEmbedUrl);
---

<section class="border-t border-line py-section lg:py-section-lg" aria-labelledby="presence-title">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4">Our presence</p>
        <h2 id="presence-title" class="t-section">Visit Boston Motors.</h2>
        <p class="mt-5 max-w-sm text-muted">
          Come see the collection, meet the team and experience Boston Motors in person.
        </p>

        {
          contact.hours && (
            <dl class="mt-8 text-sm">
              <dt class="text-muted">Showroom hours</dt>
              <dd class="mt-1 font-display font-semibold text-fg">{contact.hours}</dd>
            </dl>
          )
        }
      </div>

      <div class="flex flex-col gap-4 lg:col-span-7">
        {verifiedLocations.map((location) => <ViewOnMap location={location} />)}
      </div>
    </div>
  </Container>
</section>
