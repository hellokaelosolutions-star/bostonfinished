---
import { Image } from 'astro:assets';

import bmwFamily from '../../assets/images/customers/delivery-bmw-family.jpg';
import bmwHandshake from '../../assets/images/customers/delivery-bmw-handshake.jpg';
import mercedesHandover from '../../assets/images/customers/delivery-mercedes-handover.jpg';
import { reviewSummary, reviews } from '../../data/reviews';
import Container from '../ui/Container.astro';

/**
 * Quotes set as type, not as cards, beside the heading — then the delivery
 * photographs as a single strip beneath. Everything is visible at once; a
 * review nobody has time to wait for is a review nobody reads.
 *
 * CONTENT RULE: nothing here is invented. Quotes come from the Google listing
 * (see data/reviews.ts); the photographs are real deliveries.
 */
const photos = [
  { image: mercedesHandover, alt: 'A customer receiving the keys to a Mercedes-Benz' },
  { image: bmwFamily, alt: 'A family collecting their new BMW' },
  { image: bmwHandshake, alt: 'A handshake completing a BMW handover' },
];
---

<section class="py-section lg:py-section-lg" aria-labelledby="stories-title">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow mb-4">Customer stories</p>
        <h2 id="stories-title" class="t-section">Driven by trust.</h2>
        <p class="mt-5 max-w-sm text-muted">
          Every vehicle has a story. Every delivery begins with trust.
        </p>

        {
          reviewSummary.count > 0 && (
            <a
              href={reviewSummary.url}
              class="tap mt-3 gap-2 font-display text-sm font-semibold text-teal-light"
              target="_blank"
              rel="noopener noreferrer"
            >
              {reviewSummary.average
                ? `${reviewSummary.average.toFixed(1)} from ${reviewSummary.count} Google reviews`
                : `${reviewSummary.count} reviews on Google`}
              <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
      </div>

      <ul class="grid gap-10 sm:grid-cols-2 sm:gap-8 lg:col-span-8">
        {
          reviews.map((review) => (
            <li>
              <figure class="border-t border-line pt-6">
                <div
                  class="flex items-center gap-0.5"
                  role="img"
                  aria-label={`${review.rating} out of 5 stars`}
                >
                  {Array.from({ length: 5 }).map((_, star) => (
                    <svg
                      viewBox="0 0 20 20"
                      class:list={[
                        'h-3.5 w-3.5',
                        star < review.rating ? 'fill-teal-light' : 'fill-line',
                      ]}
                      aria-hidden="true"
                    >
                      <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                    </svg>
                  ))}
                </div>

                <blockquote class="mt-5 font-display text-lg leading-snug font-medium whitespace-pre-line text-fg sm:text-xl">
                  “{review.quote}”
                </blockquote>

                <figcaption class="mt-6 text-sm">
                  <span class="font-display font-semibold text-fg">{review.name}</span>
                  <span class="text-muted">
                    {' '}
                    · Google review{review.date ? ` · ${review.date}` : ''}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Three equal frames on a phone are thumbnails nobody can read, so the
        first photograph leads full width and the other two pair beneath it. */}
    <ul class="mt-12 grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-4 lg:mt-20">
      {
        photos.map((photo, index) => (
          <li class:list={['overflow-hidden rounded-md bg-panel', index === 0 && 'col-span-2 sm:col-span-1']}>
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[240, 420, 640, 800]}
              sizes={index === 0 ? '(min-width: 640px) 32vw, 92vw' : '(min-width: 640px) 32vw, 46vw'}
              loading="lazy"
              class:list={[
                'h-full w-full object-cover sm:aspect-5/4',
                index === 0 ? 'aspect-3/2' : 'aspect-square',
              ]}
            />
          </li>
        ))
      }
    </ul>
  </Container>
</section>
