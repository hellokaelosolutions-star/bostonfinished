---
import { Image } from 'astro:assets';

import aboutBg from '../../assets/images/about/about-bg.jpg';
import { reviewSummary } from '../../data/reviews';
import { stats } from '../../data/stats';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

/**
 * Editorial composition with the photograph as the stage.
 *
 * The previous version set the type in a centred column and put the image
 * beneath it, and the two never read as one thing — a block of text floating in
 * dark space, then a picture. The fix was not less whitespace; it was a bigger
 * visual anchor. The photograph now runs the full container width and the
 * evidence cards sit ON it, which is what ties the halves together.
 *
 * ⚠️ THE CARDS ARE EVIDENCE, AND THE TWO ARE NOT THE SAME KIND OF THING.
 *
 * The reference this borrows from floats SaaS feature cards with NEW / POPULAR
 * badges. Boston Motors has no feature matrix, so these carry facts instead —
 * and how each renders depends on whether a reader could check it:
 *
 *   Customers served — a CLAIM. Supplied by Boston Motors with no public
 *     source. Plain text, never a link, because a link implies a source.
 *     See the warning at the top of `data/stats.ts`.
 *
 *   Google reviews — EVIDENCE. Links to the listing, which is somewhere a
 *     reader can actually go and count.
 *
 * Either disappears if its data is missing, and if both go the photograph
 * stands alone. Nothing here is written to fill space.
 *
 * Still NOT on a card: "certified", vehicles sold, years in business. Those are
 * the other numbers a composition like this wants, and they do not exist.
 * See CONTENT-REQUIRED.md.
 */

type FactCard = {
  label: string;
  value: string;
  href: string | null;
  place: 'lead' | 'trail';
};

// Typed nullable up front, then narrowed — annotating the literal as
// `FactCard[]` would put the annotation on the array before the filter runs.
const candidates: (FactCard | null)[] = [
  stats.customersServed
    ? { label: 'Customers served', value: stats.customersServed, href: null, place: 'lead' }
    : null,
  reviewSummary.count > 0
    ? {
        label: 'Rated on Google',
        value: reviewSummary.average
          ? `${reviewSummary.average.toFixed(1)} from ${reviewSummary.count}`
          : `${reviewSummary.count} reviews`,
        href: reviewSummary.url,
        place: 'trail',
      }
    : null,
];

const facts = candidates.filter((fact): fact is FactCard => fact !== null);
---

<section class="about py-section lg:py-section-lg" aria-labelledby="about-preview-title">
  <Container>
    {/* Entrance order is text → image → cards → CTA, so the section assembles
        around the photograph rather than everything arriving at once. */}
    <p class="eyebrow about-eyebrow" data-reveal>About Boston Motors</p>

    <h2 id="about-preview-title" class="about-title" data-reveal style="--reveal-delay: 60ms">
      More than<br />a dealership.
    </h2>

    <p class="about-lead" data-reveal style="--reveal-delay: 120ms">
      A growing automotive company built on the belief that buying a pre-owned car should feel as
      considered as buying a new one.
    </p>

    <div class="about-stage">
      <figure class="about-media relative" data-reveal-media style="--reveal-delay: 180ms">
        <Image
          src={aboutBg}
          alt="The Boston Motors showroom storefront"
          widths={[700, 1100, 1600]}
          sizes="(min-width: 1024px) 78rem, 94vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/25"></div>
      </figure>

      {
        facts.map((fact, index) => {
          const Tag = fact.href ? 'a' : 'div';
          return (
            <Tag
              class:list={['about-card', `about-card--${fact.place}`]}
              href={fact.href ?? undefined}
              target={fact.href ? '_blank' : undefined}
              rel={fact.href ? 'noopener noreferrer' : undefined}
              data-reveal
              style={`--reveal-delay: ${320 + index * 90}ms`}
            >
              <span class="about-card__label">{fact.label}</span>
              <span class="about-card__value">{fact.value}</span>
            </Tag>
          );
        })
      }
    </div>

    <div class="about-cta" data-reveal style="--reveal-delay: 480ms">
      <Button href="/about" variant="ghost">
        Our story
        <span
          class="transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </Button>
    </div>
  </Container>
</section>

<style>
  .about {
    text-align: center;
  }

  .about-eyebrow {
    display: inline-block;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
  }

  .about-title {
    margin-top: 2rem;
    font-size: clamp(2.4rem, 5.6vw, 4.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.032em;
  }

  .about-lead {
    /* ~62 characters — inside the measure, and short enough that centring it
       stays under the three-line threshold where centred text starts costing
       more than it gains. */
    max-width: 34rem;
    margin: 1.35rem auto 0;
    color: var(--color-muted);
  }

  .about-stage {
    position: relative;
    margin-top: 2.75rem;
  }

  .about-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-band);
    /* Source is a genuine 1.50 landscape, so 4/3 on mobile and 16/9 up top are
       both gentle corrections rather than re-frames. */
    aspect-ratio: 4 / 3;
  }

  /*
    Cards sit ON the photograph, and that only works because of what the
    photograph is. Measured: the lower band of this image has a median of
    rgb(2,12,13) and a 95th percentile of rgb(3,13,14) — it is effectively
    black there. A plain `--color-panel` card would be a 7 L* step against it,
    visible but weak, so the fill is lifted and a hairline does the rest.

    `backdrop-filter` is deliberately NOT used: there is nothing behind these
    to blur. It would cost a compositor layer and change nothing.
  */
  .about-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-panel) 92%, #ffffff);
    text-align: left;
    transition:
      transform var(--duration-normal) var(--ease-out-soft),
      border-color var(--duration-normal) var(--ease-out-soft);
  }

  a.about-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-teal-light);
  }

  .about-card__label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal-light);
  }

  .about-card__value {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .about-cta {
    margin-top: 2.25rem;
  }

  /* --- Mobile -------------------------------------------------------------
     Cards drop below the image and sit side by side. Two overlay cards on a
     375px-wide photograph would cover most of the subject and collide. */
  @media (max-width: 767px) {
    .about-card {
      position: static;
    }

    .about-stage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .about-media {
      grid-column: 1 / -1;
      margin-bottom: 0.1rem;
    }
  }

  /* --- md and up ----------------------------------------------------------
     The cards move onto the photograph, diagonally opposed, which is what
     stops the type above and the image below reading as two separate things. */
  @media (min-width: 768px) {
    .about-media {
      aspect-ratio: 16 / 9;
    }

    .about-card {
      position: absolute;
      width: clamp(11rem, 17vw, 13.5rem);
      padding: 1rem 1.15rem;
    }

    .about-card--lead {
      bottom: 8%;
      left: 4%;
    }

    .about-card--trail {
      top: 10%;
      right: 4%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-card,
    a.about-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
