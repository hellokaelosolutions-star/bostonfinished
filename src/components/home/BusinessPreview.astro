---
import { Image } from 'astro:assets';

import { services } from '../../data/services';
import Container from '../ui/Container.astro';

/**
 * Three lines of business, shown side by side and all at once. They are
 * parallel offers, not a sequence, so nothing is hidden behind a carousel and
 * nothing is numbered. Each one links to its section on /business.
 */
---

<section class="py-section lg:py-section-lg" aria-labelledby="biz-title">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">Our business</p>
        <h2 id="biz-title" class="t-section">More than a vehicle.</h2>
      </div>

      <a
        href="/business/"
        class="tap hidden gap-2 font-display text-sm font-semibold text-muted transition-colors hover:text-fg sm:inline-flex"
      >
        About our services <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <ul class="mt-12 grid gap-12 md:grid-cols-3 md:gap-6 lg:gap-8">
      {
        services.map((service) => (
          <li>
            <a href={`/business/#${service.id}`} class="group block">
              <div class="overflow-hidden rounded-md bg-panel">
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 31vw, 100vw"
                  loading="lazy"
                  class="aspect-4/3 w-full object-cover transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-soft)] group-hover:scale-[1.03]"
                />
              </div>

              <h3 class="mt-5 font-display text-xl font-semibold">{service.title}</h3>
              <p class="mt-2 max-w-sm card-copy">{service.summary}</p>

              <span class="mt-4 inline-flex items-center gap-2 font-display text-sm font-semibold text-teal-light">
                Explore {service.title}
                <span
                  class="transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
