---
import { Image } from 'astro:assets';

import { services } from '../../data/services';
import Container from '../ui/Container.astro';

/**
 * The Business Preview Section — Centered 3D Rotating Tiles Carousel
 *
 * Meticulously aligned following UI/UX Pro Max principles:
 * 1. Strict Central Axis Alignment: Eyebrow, Heading, Flanking Rail, Summary, and Controls
 *    all align dead-center with mathematical optical balance.
 * 2. Integrated Precision Controls: Previous/Next arrows and interactive dots are centered
 *    above the 3D stage, completely eliminating arrow collisions over the side cards.
 * 3. 3D Rotating Stage: Center active card (sharp, highlighted, elevated) with left/right
 *    angled flanking cards (rotated, scaled, softly blurred).
 * 4. Generous Bottom Viewport Clearance: Budgeted so the entire card sits comfortably above
 *    the bottom edge with ample breathing room.
 * 5. Full Interactivity: Scroll-driven 3D rotation + click on side tiles + click on rail tabs +
 *    click on prev/next arrows + touch swipe on mobile.
 */
const total = String(services.length).padStart(2, '0');

const initialOrder = (index: number) => (index === 0 ? 0 : index === 1 ? 1 : -1);
---

<section class="biz" data-biz aria-labelledby="biz-title">
  <div class="biz-sticky">
    <Container class="biz-container">
      {/* 1. Eyebrow & Lead Statement */}
      <div class="biz-header">
        <p class="eyebrow biz-eyebrow">Our business</p>
        <h2 id="biz-title" class="biz-lead">More than a vehicle.</h2>
      </div>

      {/* 2. Flanking Service Rail (Mathematically Centered) */}
      <div class="biz-rail" role="tablist" aria-label="Boston Motors services">
        {
          services.map((service, index) => (
            <button
              type="button"
              class:list={['biz-name', index === 0 && 'is-active']}
              id={`biz-tab-${service.id}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`biz-panel-${service.id}`}
              style={`order: ${initialOrder(index)}`}
              data-biz-tab
              data-index={index}
            >
              {service.title}
            </button>
          ))
        }
      </div>

      {/* 3. Dynamic Summary & CTA (Centered & Balanced) */}
      <div class="biz-panels">
        {
          services.map((service, index) => (
            <div
              class:list={['biz-panel', index === 0 && 'is-active']}
              id={`biz-panel-${service.id}`}
              role="tabpanel"
              aria-labelledby={`biz-tab-${service.id}`}
              data-biz-panel
              data-index={index}
            >
              <p class="biz-summary">{service.summary}</p>
              <div class="biz-link-wrap">
                <a href={`/business#${service.id}`} class="biz-link link-underline">
                  Explore {service.title}
                  <span class="biz-link-arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </div>
            </div>
          ))
        }
      </div>

      {/* 4. Integrated Central Control Bar (Arrows + Dots + Counter) */}
      <div class="biz-controls-bar">
        <button
          type="button"
          class="biz-ctrl-btn biz-ctrl-btn--prev"
          aria-label="Previous service"
          data-biz-prev
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <div class="biz-dots" role="tablist" aria-label="Service slide indicators">
          {
            services.map((service, index) => (
              <button
                type="button"
                class:list={['biz-dot', index === 0 && 'is-active']}
                data-biz-dot={index}
                aria-label={`Go to ${service.title}`}
                aria-selected={index === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>

        <span class="biz-counter-text">
          <strong data-biz-current>01</strong>
          <span class="biz-counter-sep">/</span>
          <span class="biz-counter-total">{total}</span>
        </span>

        <button
          type="button"
          class="biz-ctrl-btn biz-ctrl-btn--next"
          aria-label="Next service"
          data-biz-next
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>
      </div>

      {/* 5. 3D Rotating Tiles Stage (100% Unclipped, Symmetrically Framed) */}
      <div class="biz-stage" data-biz-stage>
        <div class="biz-perspective">
          {
            services.map((service, index) => (
              <div
                class:list={[
                  'biz-tile',
                  index === 0 && 'is-active',
                  index === 1 && 'is-next',
                  index === 2 && 'is-prev',
                ]}
                data-biz-tile
                data-index={index}
                role="button"
                tabindex="0"
                aria-label={`View ${service.title}`}
              >
                <div class="biz-tile-inner">
                  <Image
                    src={service.image}
                    alt={service.alt}
                    widths={[500, 800, 1100]}
                    sizes="(min-width: 1024px) 28rem, 85vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="biz-tile-image"
                  />
                  <div class="biz-tile-scrim" aria-hidden="true" />
                  <div class="biz-tile-badge">
                    <span class="biz-tile-num">{String(index + 1).padStart(2, '0')}</span>
                    <span class="biz-tile-title">{service.title}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------------------
     Container & Viewport Budgeting
     - min-height: 250vh provides smooth scroll distance to rotate through the 3 tiles.
     - max-height: calc(100vh - 4.5rem) guarantees the section fits within 100%
       of the screen height with generous bottom clearance.
     --------------------------------------------------------------------------- */
  .biz {
    position: relative;
    text-align: center;
    min-height: 250vh;
    background-color: var(--color-bg);
  }

  .biz-sticky {
    position: sticky;
    top: 4.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 4.5rem);
    max-height: calc(100vh - 4.5rem);
    overflow: hidden;
    padding-top: clamp(0.5rem, 1.5vh, 1.25rem);
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .biz-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-inline: auto;
    text-align: center;
  }

  /* --- 1. Header --- */
  .biz-header {
    text-align: center;
    margin-inline: auto;
  }

  .biz-eyebrow {
    display: inline-block;
    color: var(--color-teal-light);
    margin-bottom: 0.2rem;
  }

  .biz-lead {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin: 0;
    text-align: center;
  }

  /* --- 2. Flanking Rail (Mathematically Centered) --- */
  .biz-rail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    margin-top: 0.35rem;
    margin-inline: auto;
    width: 100%;
    max-width: 36rem;
  }

  .biz-name {
    border: 0;
    background: none;
    padding: 0.2rem 0.4rem;
    font-family: var(--font-display);
    cursor: pointer;
    text-align: center;
    transition:
      color var(--duration-normal) var(--ease-out-soft),
      transform var(--duration-normal) var(--ease-out-soft),
      opacity var(--duration-normal) var(--ease-out-soft);
  }

  /* Equal flanking widths lock the active item dead-center */
  .biz-name:not(.is-active) {
    flex: 0 0 clamp(6rem, 13vw, 10.5rem);
    font-size: clamp(0.8125rem, 1.1vw, 0.9375rem);
    font-weight: 500;
    color: var(--color-muted);
    opacity: 0.65;
  }

  .biz-name:not(.is-active):hover {
    color: var(--color-fg);
    opacity: 1;
    transform: translateY(-1px);
  }

  .biz-name.is-active {
    flex: 0 0 auto;
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-teal-light);
    cursor: default;
  }

  /* --- 3. Dynamic Summary & CTA (Strict Center Alignment) --- */
  .biz-panels {
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    margin-top: 0.4rem;
    min-height: 3.25rem;
    text-align: center;
  }

  .biz-panel {
    display: none;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 280ms var(--ease-out-soft),
      transform 280ms var(--ease-out-soft);
    text-align: center;
  }

  .biz-panel.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .biz-summary {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.45;
    margin: 0 auto;
    text-align: center;
    max-width: 26rem;
  }

  .biz-link-wrap {
    display: flex;
    justify-content: center;
    margin-top: 0.35rem;
  }

  .biz-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-fg);
    text-align: center;
  }

  .biz-link-arrow {
    transition: transform var(--duration-fast) var(--ease-out-soft);
  }

  .biz-link:hover .biz-link-arrow {
    transform: translateX(4px);
  }

  /* --- 4. Central Integrated Controls Bar --- */
  .biz-controls-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.65rem;
    margin-inline: auto;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(11, 24, 28, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    z-index: 20;
  }

  .biz-ctrl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--color-band);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out-soft);
  }

  .biz-ctrl-btn:hover {
    border-color: var(--color-teal-light);
    color: var(--color-fg);
    background: var(--color-panel);
    transform: scale(1.08);
  }

  .biz-dots {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .biz-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-line);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out-soft);
  }

  .biz-dot.is-active {
    width: 1.25rem;
    background: var(--color-teal-light);
    box-shadow: 0 0 10px rgba(25, 184, 198, 0.4);
  }

  .biz-counter-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    margin-left: 0.25rem;
  }

  .biz-counter-text strong {
    color: var(--color-fg);
  }

  .biz-counter-sep {
    margin-inline: 0.15rem;
    opacity: 0.4;
  }

  /* ---------------------------------------------------------------------------
     5. 3D Rotating Tiles Stage
     --------------------------------------------------------------------------- */
  .biz-stage {
    position: relative;
    width: 100%;
    max-width: 56rem;
    height: clamp(210px, 32vh, 300px);
    margin-top: 0.85rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .biz-perspective {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    perspective-origin: center center;
  }

  .biz-tile {
    position: absolute;
    width: clamp(230px, 32vw, 350px);
    height: 100%;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .biz-tile-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-band);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7);
  }

  .biz-tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 750ms var(--ease-out-soft);
  }

  .biz-tile:hover .biz-tile-image {
    transform: scale(1.03);
  }

  .biz-tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(7, 16, 20, 0.85) 0%,
      rgba(7, 16, 20, 0.2) 40%,
      transparent 70%
    );
    pointer-events: none;
  }

  .biz-tile-badge {
    position: absolute;
    bottom: 0.85rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .biz-tile-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-teal-light);
  }

  .biz-tile-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  /* 3D Tile States */
  .biz-tile.is-active {
    transform: translateX(0) scale(1) translateZ(40px) rotateY(0deg);
    opacity: 1;
    filter: none;
    z-index: 10;
    cursor: default;
    box-shadow:
      0 24px 48px -12px rgba(0, 0, 0, 0.85),
      0 0 28px rgba(25, 184, 198, 0.2);
  }

  .biz-tile.is-active .biz-tile-inner {
    border-color: rgba(25, 184, 198, 0.5);
  }

  .biz-tile.is-prev {
    transform: translateX(-70%) scale(0.82) translateZ(-50px) rotateY(15deg);
    opacity: 0.38;
    filter: blur(1.5px) brightness(0.65);
    z-index: 5;
  }

  .biz-tile.is-prev:hover {
    opacity: 0.8;
    filter: blur(0px) brightness(0.85);
  }

  .biz-tile.is-next {
    transform: translateX(70%) scale(0.82) translateZ(-50px) rotateY(-15deg);
    opacity: 0.38;
    filter: blur(1.5px) brightness(0.65);
    z-index: 5;
  }

  .biz-tile.is-next:hover {
    opacity: 0.8;
    filter: blur(0px) brightness(0.85);
  }

  @media (max-width: 640px) {
    .biz-tile.is-prev {
      transform: translateX(-56%) scale(0.76) translateZ(-70px) rotateY(16deg);
      opacity: 0.25;
    }
    .biz-tile.is-next {
      transform: translateX(56%) scale(0.76) translateZ(-70px) rotateY(-16deg);
      opacity: 0.25;
    }
  }

  /* ---------------------------------------------------------------------------
     Progressive Enhancement Fallback (Without JS)
     --------------------------------------------------------------------------- */
  :global(html:not(.js)) .biz {
    min-height: auto;
  }

  :global(html:not(.js)) .biz-sticky {
    position: static;
    min-height: auto;
    max-height: none;
    padding-block: var(--spacing-section);
  }

  :global(html:not(.js)) .biz-controls-bar {
    display: none;
  }

  :global(html:not(.js)) .biz-panel,
  :global(html:not(.js)) .biz-tile {
    position: static;
    display: block;
    opacity: 1;
    transform: none;
    filter: none;
    width: 100%;
    margin-top: 1.5rem;
  }

  /* ---------------------------------------------------------------------------
     Reduced Motion
     --------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .biz-tile,
    .biz-panel,
    .biz-name,
    .biz-ctrl-btn,
    .biz-dot {
      transition: none !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  const initBusinessSection = () => {
    const root = document.querySelector<HTMLElement>('[data-biz]');
    if (!root) return;

    const tabs = [...root.querySelectorAll<HTMLElement>('[data-biz-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-biz-panel]')];
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-biz-tile]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-biz-dot]')];
    const counterEl = root.querySelector<HTMLElement>('[data-biz-current]');
    const prevBtn = root.querySelector<HTMLElement>('[data-biz-prev]');
    const nextBtn = root.querySelector<HTMLElement>('[data-biz-next]');
    const stage = root.querySelector<HTMLElement>('[data-biz-stage]');

    const count = tabs.length;
    let active = 0;
    let isUserTriggered = false;

    const flankOrder = (offset: number) => {
      if (offset === 0) return 0;
      return offset <= Math.floor(count / 2) ? offset : offset - count;
    };

    const rotateTo = (nextIndex: number) => {
      active = (nextIndex + count) % count;

      // 1. Update rail tabs and order
      tabs.forEach((tab, index) => {
        const isActive = index === active;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.style.order = String(flankOrder((index - active + count) % count));
      });

      // 2. Update summary panels
      panels.forEach((panel, index) => {
        panel.classList.toggle('is-active', index === active);
      });

      // 3. Update 3D rotating tiles
      tiles.forEach((tile, index) => {
        tile.classList.remove('is-active', 'is-prev', 'is-next');
        if (index === active) {
          tile.classList.add('is-active');
        } else if (index === (active - 1 + count) % count) {
          tile.classList.add('is-prev');
        } else {
          tile.classList.add('is-next');
        }
      });

      // 4. Update indicators & counter
      dots.forEach((dot, index) => {
        const isActive = index === active;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });

      if (counterEl) {
        counterEl.textContent = String(active + 1).padStart(2, '0');
      }
    };

    const handleUserSelect = (targetIndex: number) => {
      isUserTriggered = true;
      rotateTo(targetIndex);
      setTimeout(() => {
        isUserTriggered = false;
      }, 700);
    };

    // Click tabs in the rail
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => handleUserSelect(index));
    });

    // Click dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => handleUserSelect(index));
    });

    // Click tiles directly to rotate to center
    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => {
        if (index !== active) {
          handleUserSelect(index);
        }
      });
    });

    // Arrow navigation
    prevBtn?.addEventListener('click', () => handleUserSelect(active - 1));
    nextBtn?.addEventListener('click', () => handleUserSelect(active + 1));

    // Keyboard navigation
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        handleUserSelect(active + 1);
      } else if (e.key === 'ArrowLeft') {
        handleUserSelect(active - 1);
      }
    });

    // Mobile touch swipe
    let touchStartX = 0;
    stage?.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );

    stage?.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            handleUserSelect(active + 1);
          } else {
            handleUserSelect(active - 1);
          }
        }
      },
      { passive: true },
    );

    // Scroll-driven 3D rotation
    let ticking = false;
    const updateFromScroll = () => {
      ticking = false;
      if (isUserTriggered) return;

      const bounds = root.getBoundingClientRect();
      const travel = Math.max(root.offsetHeight - window.innerHeight, 1);
      if (bounds.top <= 0 && bounds.bottom >= window.innerHeight) {
        const progress = Math.max(0, Math.min(0.999, -bounds.top / travel));
        const computedIndex = Math.min(count - 1, Math.floor(progress * count));
        if (computedIndex !== active) {
          rotateTo(computedIndex);
        }
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(updateFromScroll);
        }
      },
      { passive: true },
    );

    rotateTo(0);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBusinessSection);
  } else {
    initBusinessSection();
  }
</script>
